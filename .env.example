# ─────────────────────────────────────────────────────────────────
# Vasudha Connect — Environment Variables
# Copy this file to .env.local and fill in your values.
# Never commit .env.local to git.
# ─────────────────────────────────────────────────────────────────

# Supabase — get these from: https://supabase.com → Project → Settings → API

# Your Supabase project URL (safe to expose publicly)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Your anon/public key (safe to expose publicly — RLS enforces security)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Your service role key (KEEP SECRET — never expose in client code or git)
# Used only for admin operations (edit, delete, link relatives)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
